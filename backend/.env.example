# Database
# SQLite (default, easy local dev — no setup required):
DATABASE_URL=sqlite+aiosqlite:///./portfoliolens.db
# Postgres (production-like):
# DATABASE_URL=postgresql+asyncpg://portfoliolens:portfoliolens@localhost:5432/portfoliolens

# OpenAI (optional — if blank, rule-based insights are generated instead)
OPENAI_API_KEY=

# Brave Search (optional — used to surface real-world events in coaching insights)
BRAVE_API_KEY=

# App
APP_ENV=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RISK_FREE_RATE=0.05
BENCHMARK_TICKER=SPY
